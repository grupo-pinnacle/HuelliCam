{
  "expo": {
    "name": "Huellicam",
    "slug": "huellicam",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "huellicam",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFBEF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.huellicam.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Permite a Huellicam acceder a tu cámara para realizar videoconsultas veterinarias en vivo.",
        "NSMicrophoneUsageDescription": "Permite a Huellicam acceder a tu micrófono para comunicarte durante la videoconsulta.",
        "NSPhotoLibraryUsageDescription": "Permite a Huellicam adjuntar fotos y recetas clínicas de tu mascota."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFBEF"
      },
      "package": "com.huellicam.app",
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#FFFBEF",
          "imageWidth": 220
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permite a Huellicam acceder a tu cámara para la videoconsulta médica.",
          "microphonePermission": "Permite a Huellicam acceder a tu micrófono para comunicarte durante la videoconsulta.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite a Huellicam adjuntar fotos clínicas de tu mascota al chat médico."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#315F5D"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e578295e-7fa0-4727-b57c-4c31b6df01aa"
      }
    }
  }
}
