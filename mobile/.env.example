# --- MOBILE ENVIRONMENT VARIABLES (.env) ---
# URL base de la Web App responsive que carga el shell WebView.
# Para probar con USB y `adb reverse tcp:5173 tcp:5173` (habilita camara/mic WebRTC):
#   EXPO_PUBLIC_WEB_URL=http://localhost:5173
# Para produccion (obligatorio HTTPS antes de compilar Store):
#   EXPO_PUBLIC_WEB_URL=https://app.huellicam.com.ar
EXPO_PUBLIC_WEB_URL=http://localhost:5173

# Base URL del Backend API (registro de tokens Push FCM/Expo).
# Con USB `adb reverse tcp:3001 tcp:3001`:
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_WS_URL=http://localhost:3001
