{
  "name": "huellicam",
  "version": "2.0.0",
  "private": true,
  "description": "Huellicam — Plataforma Marca Blanca de Telemedicina Veterinaria",
  "workspaces": [
    "backend",
    "web",
    "mobile"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,WEB\" -c \"blue,green\" \"npm run dev -w backend\" \"npm run dev -w web\"",
    "dev:backend": "npm run dev -w backend",
    "dev:web": "npm run dev -w web",
    "dev:mobile": "npm start -w mobile",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "check:governance": "node scripts/verify-governance.js",
    "verify:predeploy": "npm run check:governance && npm run typecheck && npm test && npm run build",
    "prisma:generate": "npm run prisma:generate -w backend",
    "postinstall": "npm run prisma:generate || true",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "jest": "^29.7.0"
  },
  "overrides": {
    "@chromatic-com/storybook": {
      "storybook": "^10.6.9"
    },
    "@storybook/core": "8.6.19",
    "@storybook/test": "8.6.19",
    "body-parser": "^2.4.0",
    "decode-uri-component": "^0.5.1",
    "follow-redirects": "^1.16.3",
    "handlebars": "^4.7.10",
    "image-size": "^2.1.0",
    "node-forge": "^1.4.4",
    "postcss": "^8.5.33",
    "query-string": "^9.5.1",
    "shell-quote": "^1.12.0",
    "source-map-js": "^1.2.4",
    "undici": "^6.29.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
