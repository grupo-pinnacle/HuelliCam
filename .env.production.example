# ==============================================================================
# HUELLICAM MONOREPO — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Coolify VPS / Vercel / Supabase / LiveKit Cloud Deployment
# ==============================================================================

# Backend Node.js / Express Settings
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Supabase PostgreSQL Cloud Database (Prisma 6)
# DATABASE_URL uses transaction pooler port 6543 with pgbouncer=true
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=20"
# DIRECT_URL uses direct session port 5432 for Prisma migrations
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Redis (REQUIRED in production): Socket.io adapter, presence, rate limiting and the
# persisted vet-disconnect deadlines. The server aborts startup without a valid URL.
# Option A - Redis on the same VPS (docker-compose.redis.yml, service name "redis"):
#   REDIS_URL="redis://default:[REDIS_PASSWORD]@redis:6379"
# Option B - Upstash / managed Redis with TLS:
REDIS_URL="rediss://default:[PASSWORD]@[HOST].upstash.io:6379"
# Redis must run with maxmemory-policy noeviction and persistence (AOF) enabled.

# Authentication Dual JWT Secrets (min 32 characters)
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_MIN_32_CHARS_LONG_JWT_SECRET_KEY"
JWT_REFRESH_SECRET="CHANGE_ME_IN_PRODUCTION_MIN_32_CHARS_LONG_REFRESH_SECRET"

# LiveKit WebRTC Cloud Credentials
LIVEKIT_URL="wss://huellicam.livekit.cloud"
LIVEKIT_API_KEY="APIxxxxxxxxx"
LIVEKIT_API_SECRET="secret_xxxxxxxxx"

# AWS S3 / Cloudflare R2 Secure Medical Storage (Optional)
STORAGE_DRIVER="s3" # "local" or "s3"
AWS_BUCKET_NAME="huellicam-medical-media-prod"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="AKIAxxxxxxxx"
AWS_SECRET_ACCESS_KEY="secret_xxxxxxxxx"

# CORS & Frontend URLs
CORS_ORIGIN="https://app.huellicam.com.ar,https://admin.huellicam.com.ar"
FRONTEND_URL="https://app.huellicam.com.ar"
CLIENT_URL="https://app.huellicam.com.ar"
COOKIE_SAME_SITE="none"
COOKIE_SECURE="true"

# Resend Email Dispatcher
RESEND_API_KEY="re_xxxxxxxxx"
EMAIL_FROM="Huellicam <notificaciones@huellicam.com.ar>"
ENABLE_EMAIL_SCHEDULER="true"

# Web SPA Frontend Environment Variables (Vite)
VITE_API_URL="https://api.huellicam.com.ar"
VITE_WS_URL="https://api.huellicam.com.ar"
VITE_LIVEKIT_URL="wss://huellicam.livekit.cloud"
VITE_SENTRY_DSN=""
# Expo Mobile App Public Variables
EXPO_PUBLIC_API_URL="https://api.huellicam.com.ar"
EXPO_PUBLIC_WS_URL="https://api.huellicam.com.ar"
EXPO_PUBLIC_WEB_URL="https://app.huellicam.com.ar"
