{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "types": ["jest", "node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@prisma/client": ["../../backend/node_modules/@prisma/client"],
      "@prisma/client/*": ["../../backend/node_modules/@prisma/client/*"]
    }
  },
  "include": [
    "./setup-node.ts",
    "./helpers/node/**/*.ts",
    "./backend/**/*.ts",
    "./scenarios/node/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "./frontend/**",
    "./scenarios/dom/**",
    "./helpers/dom/**",
    "./setup-dom.ts",
    "./vitest.config.ts"
  ]
}
