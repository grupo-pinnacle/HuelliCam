# ==============================================================================
# Huellicam Backend Environment Variables (Production & Staging Template)
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=production

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/huellicam_dev?schema=public"
# Direct (non-pooled) connection. Required by the Prisma CLI (`prisma migrate deploy`);
# at runtime the app falls back to DATABASE_URL when it is omitted.
DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/huellicam_dev?schema=public"

# Authentication & JWT Secrets (HMAC-SHA256)
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars"

# Redis (Redis 7). REQUIRED in production: Socket.io adapter, presence, rate limiting and
# persisted vet-disconnect deadlines. Use rediss:// for TLS providers (e.g. Upstash).
# Production Redis must use maxmemory-policy noeviction and AOF persistence.
REDIS_URL="redis://localhost:6379"

# CORS & Cross-Origin Configuration
# Comma-separated list of allowed origins
CORS_ORIGIN="https://app.huellicam.com.ar"
FRONTEND_URL="https://app.huellicam.com.ar"
CLIENT_URL="https://app.huellicam.com.ar"

# Session Cookie Options for Cross-Domain Web / Subdomains
# In production across different domains (e.g. vercel.app -> api.huellicam.com.ar):
# COOKIE_SECURE must be true (requires HTTPS on both sides)
# COOKIE_SAME_SITE must be none
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
# COOKIE_DOMAIN=.huellicam.com.ar # Optional: Set only if web and api share the root domain

# Email scheduler (enabled by default in production; set "false" to disable)
ENABLE_EMAIL_SCHEDULER=true

# Realtime tuning (optional)
# DISCONNECT_DEBOUNCE_MS=5000
# DB_POOL_LIMIT=20
# DB_POOL_TIMEOUT=15

# WebRTC Video Calling — LiveKit Cloud (SFU)
LIVEKIT_URL="wss://huellicam.livekit.cloud"
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"

# Clinical Media & Storage (Local vs S3)
STORAGE_DRIVER=local
UPLOAD_DIR="./uploads"
# AWS S3 (When STORAGE_DRIVER=s3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="huellicam-media-prod"

# Resend Email Dispatcher
RESEND_API_KEY=""
EMAIL_FROM="Huellicam <onboarding@resend.dev>"
