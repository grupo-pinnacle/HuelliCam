datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CLIENT
  VET
  ADMIN
}

enum VetStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConsultationStatus {
  WAITING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CallStatus {
  INITIATED
  ACTIVE
  ENDED
  FAILED
}

enum VaccineStatus {
  UP_TO_DATE
  UPCOMING
  OVERDUE
}

enum PetDocumentCategory {
  LAB_RESULT
  IMAGING
  CERTIFICATE
  PRESCRIPTION
  OTHER
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ClinicalTemplateKind {
  EVOLUTION
  PRESCRIPTION
}

enum LedgerEntryStatus {
  SIMULATED
  PENDING_SETTLEMENT
  SETTLED
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  password      String
  firstName     String     @map("first_name")
  lastName      String     @map("last_name")
  phone         String?
  role          Role       @default(CLIENT)
  vetStatus     VetStatus? @map("vet_status")
  licenseNumber String?    @map("license_number")
  bio           String?
  photoUrl      String?    @map("photo_url")
  tokenVersion  Int        @default(1) @map("token_version")
  ratingAvg     Float      @default(0.0) @map("rating_avg")
  ratingCount   Int        @default(0) @map("rating_count")
  isOnline      Boolean    @default(false) @map("is_online")
  lastSeen      DateTime?  @map("last_seen")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")

  pets                   Pet[]
  clientConsultations    Consultation[]          @relation("ClientConsultations")
  vetConsultations       Consultation[]          @relation("VetConsultations")
  messages               Message[]
  issuedPrescriptions    Prescription[]
  givenReviews           Review[]                @relation("GivenReviews")
  receivedReviews        Review[]                @relation("ReceivedReviews")
  auditLogs              AuditLog[]
  pushTokens             PushToken[]
  notifications          Notification[]
  mediaFiles             MediaFile[]
  dailyUploadCounters    DailyUploadCounter[]
  emailVerification      EmailVerificationToken?
  petVaccinesCreated     PetVaccine[]
  petDocumentsUploaded   PetDocument[]
  clinicalEvolutions     ClinicalEvolution[]
  coOwnedPets            PetCoOwner[]            @relation("CoOwnerUser")
  invitedCoOwners        PetCoOwner[]            @relation("CoOwnerInvitedBy")
  availabilitySlots      VetAvailabilitySlot[]
  vetFollowUps           FollowUp[]              @relation("VetFollowUps")
  clientFollowUps        FollowUp[]              @relation("ClientFollowUps")
  webPushSubscriptions   WebPushSubscription[]
  notificationPreference NotificationPreference?
  clinicalTemplates      ClinicalTemplate[]
  telemedicineConsents   TelemedicineConsent[]
  ledgerEntries          VetLedgerEntry[]

  @@index([role, isOnline, vetStatus, deletedAt])
  @@map("users")
}

model Pet {
  id                String    @id @default(uuid())
  ownerId           String    @map("owner_id")
  name              String
  species           String
  breed             String
  weightKg          Float?    @map("weight_kg")
  sex               String?
  birthDate         DateTime? @map("birth_date")
  microchip         String?
  allergies         String?
  chronicConditions String?   @map("chronic_conditions")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  owner         User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  consultations Consultation[]
  profileMedia  PetProfileMedia?
  mediaLinks    MediaPetLink[]
  vaccines      PetVaccine[]
  documents     PetDocument[]
  evolutions    ClinicalEvolution[]
  coOwners      PetCoOwner[]
  followUps     FollowUp[]

  @@index([ownerId, deletedAt])
  @@map("pets")
}

model Consultation {
  id              String             @id @default(uuid())
  clientId        String             @map("client_id")
  vetId           String?            @map("vet_id")
  petId           String             @map("pet_id")
  status          ConsultationStatus @default(WAITING)
  notes           String?
  diagnosisNotes  String?            @map("diagnosis_notes")
  startedAt       DateTime?          @map("started_at")
  endedAt         DateTime?          @map("ended_at")
  activeDeviceId  String?            @map("active_device_id")
  transportStatus String             @default("OFFLINE") @map("transport_status")
  stateVersion    Int                @default(1) @map("state_version")
  claimedAt       DateTime?          @map("claimed_at")
  livekitRoomSid  String?            @map("livekit_room_sid")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  deletedAt       DateTime?          @map("deleted_at")

  client        User                   @relation("ClientConsultations", fields: [clientId], references: [id])
  vet           User?                  @relation("VetConsultations", fields: [vetId], references: [id])
  pet           Pet                    @relation(fields: [petId], references: [id])
  messages      Message[]
  calls         Call[]
  prescriptions Prescription[]
  review        Review?
  mediaFiles    MediaFile[]
  auditLogs     ConsultationAuditLog[]
  clinicalMeta  ConsultationMetadata?
  evolutions    ClinicalEvolution[]
  petDocuments  PetDocument[]
  followUps     FollowUp[]
  ledgerEntry   VetLedgerEntry?

  @@index([clientId, status, deletedAt])
  @@index([vetId, status, deletedAt])
  @@map("consultations")
}

model ConsultationAuditLog {
  id             BigInt        @id @default(autoincrement())
  consultationId String        @map("consultation_id")
  eventType      String        @map("event_type")
  previousState  String?       @map("previous_state")
  newState       String?       @map("new_state")
  actorId        String?       @map("actor_id")
  deviceId       String?       @map("device_id")
  metadata       Json?         @default("{}")
  createdAt      DateTime      @default(now()) @map("created_at")

  consultation   Consultation  @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId, createdAt(sort: Desc)])
  @@map("consultation_audit_log")
}

model Message {
  id             String    @id @default(uuid())
  consultationId String    @map("consultation_id")
  senderId       String    @map("sender_id")
  content        String
  attachmentUrl  String?   @map("attachment_url")
  clientMsgId    String    @unique @map("client_msg_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  consultation Consultation @relation(fields: [consultationId], references: [id])
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([consultationId, createdAt])
  @@map("messages")
}

model Call {
  id               String     @id @default(uuid())
  consultationId   String     @map("consultation_id")
  roomName         String     @map("room_name")
  livekitRoomSid   String?    @map("livekit_room_sid")
  status           CallStatus @default(INITIATED)
  startedAt        DateTime?  @map("started_at")
  endedAt          DateTime?  @map("ended_at")
  durationSeconds  Int?       @map("duration_seconds")
  participantCount Int        @default(0) @map("participant_count")
  errorCode        String?    @map("error_code")
  errorMessage     String?    @map("error_message")
  disconnectReason String?    @map("disconnect_reason")
  lastEvent        String?    @map("last_event")
  metadata         Json?
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  consultation Consultation @relation(fields: [consultationId], references: [id])

  @@index([consultationId, createdAt(sort: Desc)])
  @@index([roomName, createdAt(sort: Desc)])
  @@map("calls")
}

model Prescription {
  id             String   @id @default(uuid())
  consultationId String   @map("consultation_id")
  vetId          String   @map("vet_id")
  medication     String
  dosage         String
  frequency      String
  durationDays   Int      @map("duration_days")
  indications    String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  consultation Consultation @relation(fields: [consultationId], references: [id])
  vet          User         @relation(fields: [vetId], references: [id])

  @@map("prescriptions")
}

model Review {
  id             String   @id @default(uuid())
  consultationId String   @unique @map("consultation_id")
  clientId       String   @map("client_id")
  vetId          String   @map("vet_id")
  rating         Int
  comment        String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  consultation Consultation @relation(fields: [consultationId], references: [id])
  client       User         @relation("GivenReviews", fields: [clientId], references: [id])
  vet          User         @relation("ReceivedReviews", fields: [vetId], references: [id])

  @@map("reviews")
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String   @map("admin_id")
  action    String
  targetId  String?  @map("target_id")
  ipAddress String?  @map("ip_address")
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  admin User @relation(fields: [adminId], references: [id])

  @@map("audit_logs")
}

model DailyUploadCounter {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  date       String // Format: YYYY-MM-DD
  count      Int      @default(0)
  totalBytes BigInt   @default(0) @map("total_bytes")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@map("daily_upload_counters")
}

model MediaFile {
  id             String    @id @default(uuid())
  ownerId        String    @map("owner_id")
  consultationId String?   @map("consultation_id")
  fileName       String    @map("file_name")
  fileSize       Int       @map("file_size")
  mimeType       String    @map("mime_type")
  localPath      String?   @map("local_path")
  s3Key          String?   @map("s3_key")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  owner        User          @relation(fields: [ownerId], references: [id])
  consultation Consultation? @relation(fields: [consultationId], references: [id])
  petLink      MediaPetLink?
  petDocuments PetDocument[]
  petPhotos    PetProfileMedia[]

  @@index([ownerId, deletedAt])
  @@index([consultationId, deletedAt])
  @@map("media_files")
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  platform  String // "ios" | "android" | "web"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("push_tokens")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String
  body      String
  type      String // "CALL_INCOMING | MESSAGE_NEW | PRESCRIPTION_NEW | SYSTEM"
  data      Json?
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  email     String
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email, expiresAt])
  @@map("password_reset_tokens")
}

model EmailDispatchLog {
  id             String   @id @default(uuid())
  dedupeKey      String   @unique @map("dedupe_key")
  type           String
  entityId       String?  @map("entity_id")
  recipientEmail String   @map("recipient_email")
  sentAt         DateTime @default(now()) @map("sent_at")

  @@index([type, entityId, sentAt])
  @@map("email_dispatch_logs")
}

model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String    @unique @map("user_id")
  email      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, expiresAt])
  @@map("email_verification_tokens")
}

model PetProfileMedia {
  petId       String     @id @map("pet_id")
  mediaFileId String?    @map("media_file_id")
  photoUrl    String     @map("photo_url")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  pet       Pet        @relation(fields: [petId], references: [id], onDelete: Cascade)
  mediaFile MediaFile? @relation(fields: [mediaFileId], references: [id], onDelete: SetNull)

  @@map("pet_profile_media")
}

model MediaPetLink {
  mediaFileId String   @id @map("media_file_id")
  petId       String   @map("pet_id")
  createdAt   DateTime @default(now()) @map("created_at")

  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)
  pet       Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@map("media_pet_links")
}

model ConsultationMetadata {
  consultationId    String    @id @map("consultation_id")
  scheduledAt       DateTime? @map("scheduled_at")
  rescheduledFromId String?   @map("rescheduled_from_id")
  incidentCode      String?   @map("incident_code")
  feeSnapshot       Int?      @map("fee_snapshot")
  takeRateSnapshot  Float?    @map("take_rate_snapshot")
  currencySnapshot  String?   @map("currency_snapshot")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([scheduledAt])
  @@map("consultation_metadata")
}

model PetVaccine {
  id          String        @id @default(uuid())
  petId       String        @map("pet_id")
  createdById String        @map("created_by_id")
  name        String
  appliedAt   DateTime      @map("applied_at")
  nextDueAt   DateTime?     @map("next_due_at")
  status      VaccineStatus @default(UP_TO_DATE)
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  pet       Pet  @relation(fields: [petId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])

  @@index([petId, deletedAt])
  @@index([nextDueAt, deletedAt])
  @@map("pet_vaccines")
}

model PetDocument {
  id             String              @id @default(uuid())
  petId          String              @map("pet_id")
  consultationId String?             @map("consultation_id")
  mediaFileId    String?             @map("media_file_id")
  uploadedById   String              @map("uploaded_by_id")
  title          String
  category       PetDocumentCategory @default(OTHER)
  externalUrl    String?             @map("external_url")
  sizeLabel      String?             @map("size_label")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  deletedAt      DateTime?           @map("deleted_at")

  pet          Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)
  consultation Consultation? @relation(fields: [consultationId], references: [id])
  mediaFile    MediaFile?    @relation(fields: [mediaFileId], references: [id])
  uploadedBy   User          @relation(fields: [uploadedById], references: [id])

  @@index([petId, deletedAt])
  @@index([mediaFileId])
  @@map("pet_documents")
}

model ClinicalEvolution {
  id             String    @id @default(uuid())
  petId          String    @map("pet_id")
  consultationId String?   @map("consultation_id")
  vetId          String    @map("vet_id")
  summary        String
  subjective     String?
  objective      String?
  assessment     String?
  plan           String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  pet          Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)
  consultation Consultation? @relation(fields: [consultationId], references: [id])
  vet          User          @relation(fields: [vetId], references: [id])

  @@index([petId, createdAt(sort: Desc)])
  @@index([consultationId])
  @@map("clinical_evolutions")
}

model PetCoOwner {
  id          String    @id @default(uuid())
  petId       String    @map("pet_id")
  userId      String    @map("user_id")
  invitedById String    @map("invited_by_id")
  role        String    @default("CO_TUTOR")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  pet       Pet  @relation(fields: [petId], references: [id], onDelete: Cascade)
  user      User @relation("CoOwnerUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User @relation("CoOwnerInvitedBy", fields: [invitedById], references: [id])

  @@unique([petId, userId])
  @@index([userId])
  @@map("pet_co_owners")
}

model VetAvailabilitySlot {
  id              String   @id @default(uuid())
  vetId           String   @map("vet_id")
  dayOfWeek       Int      @map("day_of_week")
  startTime       String   @map("start_time")
  endTime         String   @map("end_time")
  slotDurationMin Int      @default(30) @map("slot_duration_min")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  vet User @relation(fields: [vetId], references: [id], onDelete: Cascade)

  @@index([vetId, dayOfWeek, isActive])
  @@map("vet_availability_slots")
}

model FollowUp {
  id             String         @id @default(uuid())
  petId          String         @map("pet_id")
  consultationId String?        @map("consultation_id")
  vetId          String         @map("vet_id")
  clientId       String         @map("client_id")
  title          String
  notes          String?
  dueAt          DateTime       @map("due_at")
  status         FollowUpStatus @default(PENDING)
  reminderSentAt DateTime?      @map("reminder_sent_at")
  completedAt    DateTime?      @map("completed_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  pet          Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)
  consultation Consultation? @relation(fields: [consultationId], references: [id])
  vet          User          @relation("VetFollowUps", fields: [vetId], references: [id])
  client       User          @relation("ClientFollowUps", fields: [clientId], references: [id])

  @@index([vetId, status, dueAt])
  @@index([clientId, status, dueAt])
  @@map("follow_ups")
}

model WebPushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("web_push_subscriptions")
}

model NotificationPreference {
  userId                String   @id @map("user_id")
  inAppEnabled          Boolean  @default(true) @map("in_app_enabled")
  pushEnabled           Boolean  @default(true) @map("push_enabled")
  emailRemindersEnabled Boolean  @default(true) @map("email_reminders_enabled")
  vaccineReminders      Boolean  @default(true) @map("vaccine_reminders")
  appointmentReminders  Boolean  @default(true) @map("appointment_reminders")
  marketingEnabled      Boolean  @default(false) @map("marketing_enabled")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model ClinicalTemplate {
  id        String               @id @default(uuid())
  vetId     String?              @map("vet_id")
  kind      ClinicalTemplateKind
  name      String
  category  String               @default("General")
  payload   Json
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  vet User? @relation(fields: [vetId], references: [id], onDelete: Cascade)

  @@index([vetId, kind])
  @@map("clinical_templates")
}

model TelemedicineConsent {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  version    String
  acceptedAt DateTime @default(now()) @map("accepted_at")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, version])
  @@map("telemedicine_consents")
}

model PlatformFeatureFlag {
  key         String   @id
  enabled     Boolean
  description String
  updatedBy   String?  @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_feature_flags")
}

model PlatformPricingSetting {
  id                 String   @id @default("default")
  baseConsultationFee Int     @default(15000) @map("base_consultation_fee")
  platformTakeRate   Float    @default(0.2) @map("platform_take_rate")
  currency           String   @default("ARS")
  updatedBy          String?  @map("updated_by")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("platform_pricing_settings")
}

model VetLedgerEntry {
  id               String            @id @default(uuid())
  consultationId   String            @unique @map("consultation_id")
  vetId            String            @map("vet_id")
  grossAmount      Int               @map("gross_amount")
  platformFee      Int               @map("platform_fee")
  vetNetAmount     Int               @map("vet_net_amount")
  currency         String            @default("ARS")
  status           LedgerEntryStatus @default(SIMULATED)
  externalProvider String?           @map("external_provider")
  externalRef      String?           @map("external_ref")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  vet          User         @relation(fields: [vetId], references: [id])

  @@index([vetId, status, createdAt(sort: Desc)])
  @@map("vet_ledger_entries")
}
